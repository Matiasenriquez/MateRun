# ==============================================================================
# ARCHIVO .gitignore - Proyecto MateRun
# ==============================================================================
# Propósito: Evitar que archivos temporales, dependencias pesadas y credenciales
# confidenciales sean versionadas en el repositorio de código fuente.
# ==============================================================================

# Dependencias de Node.js (se descargan vía npm install)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos generados por compilación (tanto en backend como en frontend)
dist/
build/
*.tsbuildinfo

# Variables de entorno y secretos confidenciales (nunca deben subirse)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Archivos de configuración de editores e IDEs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs del sistema y del servidor
logs/
*.log
