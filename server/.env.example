# ==============================================================================
# VARIABLES DE ENTORNO - SERVIDOR BACKEND (MateRun)
# ==============================================================================

# Puerto en el que se ejecutará la API de Express
PORT=5000

# URI de conexión a MongoDB (Local para desarrollo con MongoDB Compass)
# Puedes abrir MongoDB Compass y conectarte a: mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017/Db_MateRun

# Clave secreta para firmar los JSON Web Tokens (JWT)
JWT_SECRET=mate_run_super_secret_jwt_key_2026_trail_running

# Tiempo de expiración del token JWT (ejemplo: 24h, 7d)
JWT_EXPIRES_IN=24h

# URL permitida para llamadas CORS desde el Frontend React (Vite corre por defecto en el puerto 5173)
CLIENT_URL=http://localhost:5173
